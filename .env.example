# AI Configuration (Optional - intelligent local fallback engine will run if not provided)
OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Gmail SMTP Configuration for Email Reports (Optional)
# For Gmail, generate an App Password: Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Flask Configuration
PORT=5001
FLASK_ENV=development
